# ================================================================
# DNVB Sosmed Tracker — konfigurasi environment
# Salin menjadi .env.local (lokal) atau isi di Vercel → Settings → Environment Variables
# Semua kunci OPSIONAL. Tanpa kunci apa pun aplikasi tetap berjalan:
#   - Berita: Google News, Bing News, GDELT (gratis, tanpa kunci)
#   - Analisis: mesin leksikon Bahasa Indonesia (tanpa AI)
# ================================================================

# --- AI lewat SumoPod (disarankan; gateway OpenAI-compatible, https://ai.sumopod.com)
# Dipakai untuk analisis (chat) dan saringan makna (embedding). Jika diisi, GEMINI_API_KEY diabaikan.
SUMOPOD_API_KEY=
SUMOPOD_BASE_URL=https://ai.sumopod.com/v1
SUMOPOD_CHAT_MODEL=gemini/gemini-3.1-flash-lite
SUMOPOD_EMBED_MODEL=gemini/gemini-embedding-001
# Ambang saringan makna (kemiripan kosinus minimal ke profil entitas, dan selisih vs profil tandingan)
SEMANTIC_MIN=0.4
SEMANTIC_MARGIN=0.03

# --- Alternatif: Google Gemini langsung : sentimen kontekstual, ekstraksi tokoh, ringkasan eksekutif
# Dapatkan di https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- YouTube Data API v3 (gratis, kuota harian) : video + komentar publik
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# --- Apify (Instagram, TikTok, Threads + komentar; X & Facebook opsional) : https://console.apify.com/account/integrations
# Jalur utama untuk kanal inti DNVB Sosmed Tracker. Tanpa token, IG/TikTok/Threads memakai Firecrawl/Exa (lebih terbatas).
APIFY_TOKEN=
APIFY_MAX_ITEMS=60
# Actor bisa diganti bila ingin memakai scraper lain dari Apify Store
APIFY_ACTOR_X=apidojo~tweet-scraper
APIFY_ACTOR_TIKTOK=clockworks~tiktok-scraper
APIFY_ACTOR_INSTAGRAM=apify~instagram-hashtag-scraper
APIFY_ACTOR_FACEBOOK=powerai~facebook-post-search-scraper
APIFY_ACTOR_THREADS=headply~threads-scraper
# Komentar dari unggahan TikTok & Instagram teramai (0 = matikan)
APIFY_COMMENTS=1
APIFY_COMMENTS_PER_POST=40
APIFY_ACTOR_TIKTOK_COMMENTS=clockworks~tiktok-comments-scraper
APIFY_ACTOR_INSTAGRAM_COMMENTS=apify~instagram-comment-scraper

# Foto tokoh: simpan permanen di Vercel Blob (Storage > Blob, akses public). Tanpa ini, foto disimpan di browser.
BLOB_READ_WRITE_TOKEN=
# Set 0 untuk mematikan pemeriksaan foto oleh AI multimodal
PHOTO_VISION=1

# ---------------- Agent Reach (github.com/Panniantong/agent-reach) ----------------
# Jalur media sosial gratis. CLI lokal (opencli, twitter, rdt, bili, xhs, yt-dlp, gh) otomatis
# terdeteksi saat npm run dev di laptop. Lihat README bagian Agent Reach.
# twitter-cli: ekspor cookie x.com lewat Cookie-Editor, isi dua nilai ini (jangan di-commit)
TWITTER_AUTH_TOKEN=
TWITTER_CT0=
# Exa: tanpa kunci memakai MCP publik; isi kunci agar bisa dibatasi domain & tanggal (exa.ai)
EXA_API_KEY=
# Firecrawl (github.com/firecrawl/firecrawl): crawl media, jalur media sosial, pembaca artikel.
# Cloud: kunci fc-... dari firecrawl.dev. Self-host: FIRECRAWL_API_URL=http://localhost:3002 (docker compose).
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=
# Batas permintaan per pantauan (default 8); 1 = ikut ambil isi artikel saat search (lebih boros kredit)
FIRECRAWL_MAX_REQUESTS=8
FIRECRAWL_SCRAPE=
# Situs yang di-map dengan kata kunci (koma). Kosong = marketeers.com, swa.co.id, dailysocial.id, mix.co.id
FIRECRAWL_MAP_SITES=
# Jina Reader: opsional, menaikkan batas baca halaman
JINA_API_KEY=
# RSS tambahan (pisahkan dengan koma): halaman direktori, feed, dan feed pencarian dengan {q}
RSS_SITES=
RSS_DIRECTORIES=
RSS_FEEDS=
RSS_SEARCH_FEEDS=
# Anggaran permintaan Google News per pencarian (default 160)
GN_MAX_REQUESTS=160
# Jembatan untuk deploy Vercel: token acak (sama di laptop & Vercel), URL tunnel di Vercel saja
REACH_BRIDGE_TOKEN=
REACH_BRIDGE_URL=

